DATABASE_URL=postgresql://username:password@localhost:5432/khandelwalfamily
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
JWT_SECRET=change-me
PLATFORM_ADMIN_KEY=change-me

# Email (Resend HTTP API) — resend.com → API Keys.
# HTTP API is used instead of SMTP because Render blocks outbound SMTP ports.
RESEND_API_KEY=your-resend-api-key
# Sender must be on a domain verified in Resend → Domains.
EMAIL_FROM=Khandelwal Parivar <hello@dipkulkhandelwal.com>
RESET_LINK_BASE_URL=http://localhost:3000

# Cloudflare R2 photo storage (private bucket, S3 API). Leave blank to keep
# storing photos inline as data URLs (local dev without R2). All five must be
# set for R2 to activate.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Backend's own public origin, used to build /api/photos/<id>/<variant> URLs.
BACKEND_PUBLIC_URL=http://localhost:4000
